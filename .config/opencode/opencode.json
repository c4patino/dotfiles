{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "github-copilot/deepseek-v4-flash",
  "lsp": {
    "clangd": {
      "disabled": true
    },
    "pyright": {
      "disabled": true
    },
    "texlab": {
      "disabled": true
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/openspec/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    }
  ]
}
