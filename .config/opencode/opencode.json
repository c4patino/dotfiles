{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "ollama/qwen3-coder-next:q4_K_M",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/openspec/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".envrc",
      "effect": "deny"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:sudo *",
      "effect": "deny"
    }
  ],
  "agents": {
    "title": {
      "model": "ollama/qwen3.5:9b#none"
    }
  },
  "providers": {
    "ollama": {
      "settings": {
        "baseURL": "https://ollama.yumeami.sh/v1"
      },
      "compatibility": {
        "reasoningField": "reasoning"
      },
      "models": {
        "qwen3-coder-next:q4_K_M": {
          "name": "Qwen3 Coder Next",
          "limit": {
            "context": 65536
          }
        },
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B",
          "limit": {
            "context": 65536
          },
          "variants": [
            {
              "id": "none",
              "body": {
                "reasoning_effort": "none"
              }
            },
            {
              "id": "low",
              "body": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "medium",
              "body": {
                "reasoning_effort": "medium"
              }
            },
            {
              "id": "xhigh",
              "body": {
                "reasoning_effort": "xhigh"
              }
            }
          ]
        },
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B",
          "limit": {
            "context": 65536
          },
          "variants": [
            {
              "id": "none",
              "body": {
                "reasoning_effort": "none"
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning_effort": "high"
              }
            }
          ]
        }
      }
    }
  }
}
