{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "model": "github-copilot/deepseek-v4-flash",
  "lsp": {
    "clangd": {
      "disabled": true
    },
    "pyright": {
      "disabled": true
    },
    "texlab": {
      "disabled": true
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/openspec/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".envrc",
      "effect": "deny"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:sudo *",
      "effect": "deny"
    }
  ],
  "agents": {
    "title": {
      "model": "ollama/qwen3.5:9b"
    }
  },
  "providers": {
    "ollama": {
      "models": {
        "qwen3-coder-next:q4_K_M": {
          "name": "Qwen3 Coder Next",
          "limit": {
            "context": 32768
          }
        },
        "qwen3.5:9b": {
          "name": "Qwen3.5",
          "limit": {
            "context": 32768
          },
          "body": {
            "num_ctx": 4096
          }
        }
      }
    }
  }
}
